{
  "services": {
    "app": { "root": "./" },
    "backend": { "root": "backend/", "entrypoint": "main:app" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/assets/(.*)", "destination": { "service": "app" } },
    { "source": "/(favicon\\.svg|icons\\.svg)", "destination": { "service": "app" } },
    { "source": "/(.*)", "destination": { "service": "app", "path": "/index.html" } }
  ]
}
